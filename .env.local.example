# Copiá este archivo a .env.local y completá los valores reales.
# .env.local NUNCA se sube a Git (ya está en .gitignore).

# Cadena de conexión de tu cluster de MongoDB Atlas.
# La sacás desde Atlas > Database > Connect > Drivers.
MONGODB_URI=mongodb+srv://usuario:password@tucluster.mongodb.net/itelsa?retryWrites=true&w=majority

# Nombre de la base de datos dentro del cluster.
MONGODB_DB=itelsa

# Secreto para firmar las sesiones de NextAuth. Generalo con:
# openssl rand -base64 32
NEXTAUTH_SECRET=

# URL pública de la app (en Vercel: la URL que te asigna el deploy).
NEXTAUTH_URL=http://localhost:3000
